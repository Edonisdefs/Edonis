# ---------------------------------------------------------------------------
# Datenbank (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/edonis?schema=public"

# ---------------------------------------------------------------------------
# Auth – mindestens 32 Zeichen, in Produktion zwingend eigener Wert
# ---------------------------------------------------------------------------
AUTH_SECRET="bitte-durch-einen-zufaelligen-wert-ersetzen-min-32-zeichen"

# ---------------------------------------------------------------------------
# KI-Provider: "mock" | "anthropic"
# ---------------------------------------------------------------------------
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Speech-to-Text: "mock" | "openai"
# "openai" spricht das OpenAI-kompatible /audio/transcriptions-Format und
# funktioniert damit auch mit Groq, Azure oder einem eigenen Whisper-Gateway.
# ---------------------------------------------------------------------------
STT_PROVIDER="mock"
STT_API_KEY=""
STT_BASE_URL="https://api.openai.com/v1"
STT_MODEL="whisper-1"
STT_LANGUAGE="de"

# ---------------------------------------------------------------------------
# Storage: "local" | "s3"
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"
S3_BUCKET=""
S3_REGION="eu-central-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ---------------------------------------------------------------------------
# Sonstiges
# ---------------------------------------------------------------------------
# Selbstregistrierung neuer Betriebe erlauben (Demo: true)
ALLOW_SIGNUP="true"
